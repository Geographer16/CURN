# -*- coding: utf-8 -*-from collections import defaultdictimport numpy as npimport arcpyfrom arcpy.sa import (    Raster,    ExtractMultiValuesToPoints,    SetNull,    IsNull,    Con,    StreamOrder,)from joblib import loaddef optimized_touch_detection(in_fc, oid_field, messages):    vertex_list = []    with arcpy.da.SearchCursor(in_fc, [oid_field, "SHAPE@"]) as cursor:        for oid, geom in cursor:            if geom:                for part in geom:                    for point in part:                        if point:                            x = round(point.X, 6)                            y = round(point.Y, 6)                            vertex_list.append((x, y, oid))    coord_to_lines = defaultdict(set)    for x, y, line_id in vertex_list:        coord_key = f"{x}_{y}"        coord_to_lines[coord_key].add(line_id)    touch_idx = defaultdict(set)    for coord_key, line_set in coord_to_lines.items():        if len(line_set) > 1:            line_list = list(line_set)            for i in range(len(line_list)):                for j in range(i + 1, len(line_list)):                    line1 = line_list[i]                    line2 = line_list[j]                    touch_idx[line1].add(line2)                    touch_idx[line2].add(line1)    total_lines = len(set(v[2] for v in vertex_list))    total_touches = sum(len(v) for v in touch_idx.values())    messages.addMessage(f"Touch detection complete: {total_lines} lines, {total_touches} touch connections.")    return touch_idxclass Toolbox(object):    def __init__(self):        self.label = "CURN Toolbox"        self.alias = "Curn"        self.tools = [Dedect, Correct]class Dedect:    def __init__(self):        self.label = "Dedect"        self.description = "This tool identifies unrealistic segments in a river network."    def getParameterInfo(self):        params = []        params.append(arcpy.Parameter(            displayName="Strahler Merge (LS)",            name="in_line_fc",            datatype="GPFeatureLayer",            parameterType="Required",            direction="Input"        ))        params.append(arcpy.Parameter(            displayName="Digital Elevation Model",            name="in_dem",            datatype="GPRasterLayer",            parameterType="Required",            direction="Input"        ))        params.append(arcpy.Parameter(            displayName="Flow Accumulation",            name="in_flow_acc",            datatype="GPRasterLayer",            parameterType="Required",            direction="Input"        ))        params.append(arcpy.Parameter(            displayName="CURN Model (.pkl)",            name="model_path",            datatype="DEFile",            parameterType="Required",            direction="Input"        ))        params.append(arcpy.Parameter(            displayName="Output Feature",            name="out_fc",            datatype="DEFeatureClass",            parameterType="Required",            direction="Output"        ))        return params    def isLicensed(self):        return True    def execute(self, parameters, messages):        in_fc_original, in_dem, in_flow, model_path, out_fc = [p.valueAsText for p in parameters]        messages.addMessage("Creating working copy of input features...")        in_fc = arcpy.CreateScratchName("working_lines", workspace=arcpy.env.scratchGDB, data_type="FeatureClass")        arcpy.CopyFeatures_management(in_fc_original, in_fc)        verts_fld = "Vertices_Count"        slope_fld = "Slope"        spi_fld = "SPI"        len_fld = "Shape_Length"        len_meters_fld = "Length_Meters"        straight_dist_fld = "Straight_Dist"        deflection_ratio_fld = "Deflection_Ratio"        grid_fld = "grid_code"        unreal_fld = "UnRealistic"        touch_count_fld = "TouchCount"        accum_fld = "AccumTouch"        accum_vert_fld = "AccumVert"        ver_len_ratio_fld = "VerLeng_ratio"        elev_start_fld = "ELEV_START"        elev_end_fld = "ELEV_END"        flow_acc_fld = "FLOW_ACC"        existing = [f.name for f in arcpy.ListFields(in_fc)]        for fld, typ in [(verts_fld, "LONG"), (slope_fld, "FLOAT"),                         (spi_fld, "FLOAT"), (unreal_fld, "SHORT"),                         (touch_count_fld, "LONG"), (accum_fld, "LONG"),                         (accum_vert_fld, "LONG"),                         (ver_len_ratio_fld, "DOUBLE"),                         (len_meters_fld, "DOUBLE"),                         (straight_dist_fld, "DOUBLE"),                         (deflection_ratio_fld, "DOUBLE"),                         (elev_start_fld, "FLOAT"), (elev_end_fld, "FLOAT"),                         (flow_acc_fld, "FLOAT")]:            if fld not in existing:                arcpy.AddField_management(in_fc, fld, typ)        messages.addMessage("Extracting elevation and flow accumulation values...")        start_pts = "in_memory/start_points"        end_pts = "in_memory/end_points"        arcpy.CreateFeatureclass_management("in_memory", "start_points", "POINT", spatial_reference=in_fc)        arcpy.AddField_management(start_pts, "OID_LINE", "LONG")        arcpy.CreateFeatureclass_management("in_memory", "end_points", "POINT", spatial_reference=in_fc)        arcpy.AddField_management(end_pts, "OID_LINE", "LONG")        with arcpy.da.SearchCursor(in_fc, ["SHAPE@", "OID@"]) as lc:            with arcpy.da.InsertCursor(start_pts, ["SHAPE@", "OID_LINE"]) as start_cursor:                with arcpy.da.InsertCursor(end_pts, ["SHAPE@", "OID_LINE"]) as end_cursor:                    for geom, oid in lc:                        if geom:                            start_cursor.insertRow((geom.firstPoint, oid))                            end_cursor.insertRow((geom.lastPoint, oid))        dem_raster = Raster(in_dem)        flow_raster = Raster(in_flow)        ExtractMultiValuesToPoints(start_pts, [[dem_raster, "ELEV_START"]], "NONE")        ExtractMultiValuesToPoints(end_pts, [[dem_raster, "ELEV_END"]], "NONE")        ExtractMultiValuesToPoints(start_pts, [[flow_raster, "FLOW_ACC"]], "NONE")        start_values = {}        with arcpy.da.SearchCursor(start_pts, ["OID_LINE", "ELEV_START", "FLOW_ACC"]) as cursor:            for oid, elev_start, flow_acc in cursor:                start_values[oid] = {'elev_start': elev_start, 'flow_acc': flow_acc}        end_values = {}        with arcpy.da.SearchCursor(end_pts, ["OID_LINE", "ELEV_END"]) as cursor:            for oid, elev_end in cursor:                end_values[oid] = elev_end        messages.addMessage("Calculating length, slope, SPI, vertices, straight distance and deflection ratio...")        with arcpy.da.UpdateCursor(in_fc, ["OID@", "SHAPE@", len_fld, verts_fld,                                           slope_fld, spi_fld, ver_len_ratio_fld,                                           elev_start_fld, elev_end_fld, flow_acc_fld,                                           len_meters_fld, straight_dist_fld, deflection_ratio_fld]) as uc:            for row in uc:                oid, geom = row[0], row[1]                if geom:                    length = geom.getLength('GEODESIC', 'METERS')                    row[10] = length                    first_point = geom.firstPoint                    last_point = geom.lastPoint                    if first_point and last_point:                        array = arcpy.Array([first_point, last_point])                        straight_line = arcpy.Polyline(array, geom.spatialReference)                        straight_dist = straight_line.getLength('GEODESIC', 'METERS')                        row[11] = straight_dist                        if straight_dist > 0:                            deflection = length / straight_dist                            row[12] = deflection                        else:                            row[12] = None                    else:                        row[11] = None                        row[12] = None                else:                    length = None                    row[10] = None                    row[11] = None                    row[12] = None                row[3] = len(geom.getPart(0)) if geom else 0                if oid in start_values and oid in end_values:                    elev_start = start_values[oid]['elev_start']                    elev_end = end_values[oid]                    flow_acc = start_values[oid]['flow_acc']                    row[7] = elev_start                    row[8] = elev_end                    row[9] = flow_acc                    if elev_start is not None and elev_end is not None and length and length > 0:                        elevation_diff = abs(elev_start - elev_end)                        slope_percent = (elevation_diff / length) * 100.0                        row[4] = slope_percent                        if flow_acc is not None:                            spi_value = np.log((flow_acc + 0.001) * ((slope_percent / 100.0) + 0.001))                            row[5] = float(spi_value)                        else:                            row[5] = None                    else:                        row[4] = None                        row[5] = None                else:                    row[4] = None                    row[5] = None                    row[7] = None                    row[8] = None                    row[9] = None                verts = row[3]                row[6] = (verts / length * 100.0) if length and verts is not None else None                uc.updateRow(row)        messages.addMessage("Building touch relationships between lines...")        oid_field = arcpy.Describe(in_fc).OIDFieldName        touch_idx = optimized_touch_detection(in_fc, oid_field, messages)        with arcpy.da.UpdateCursor(in_fc, [oid_field, touch_count_fld]) as uc2:            for row in uc2:                row[1] = len(touch_idx.get(row[0], set()))                uc2.updateRow(row)        messages.addMessage("Calculating AccumTouch and AccumVert...")        attrs = {}        with arcpy.da.SearchCursor(in_fc, [oid_field, grid_fld, touch_count_fld, verts_fld]) as cursor:            for oid, grid, touch, verts in cursor:                attrs[oid] = {                    'grid': grid if grid is not None else 0,                    'touch': touch if touch is not None else 0,                    'verts': verts if verts is not None else 0,                    'accum': 0,                    'accum_vert': 0                }        levels = sorted(set(v['grid'] for v in attrs.values()))        computed = {}        computed_vert = {}        for lvl in levels:            level_oids = [oid for oid, v in attrs.items() if v['grid'] == lvl]            for oid in level_oids:                total_contributions = 0                total_vert_contributions = 0                neighbors = touch_idx.get(oid, set())                for nbr in neighbors:                    if nbr in attrs:                        nbr_grid = attrs[nbr]['grid']                        if nbr_grid < lvl:                            nbr_accum = computed.get(nbr, 0)                            contribution = nbr_accum + 1                            total_contributions += contribution                            nbr_accum_vert = computed_vert.get(nbr, 0)                            nbr_verts = attrs[nbr]['verts']                            vert_contribution = nbr_accum_vert + nbr_verts                            total_vert_contributions += vert_contribution                computed[oid] = total_contributions                attrs[oid]['accum'] = total_contributions                computed_vert[oid] = total_vert_contributions                attrs[oid]['accum_vert'] = total_vert_contributions        with arcpy.da.UpdateCursor(in_fc, [oid_field, accum_fld, accum_vert_fld]) as uc3:            for row in uc3:                row[1] = attrs[row[0]]['accum']                row[2] = attrs[row[0]]['accum_vert']                uc3.updateRow(row)        messages.addMessage("Loading model and verifying compatibility...")        try:            model = load(model_path)            if hasattr(model, 'feature_names_in_'):                feature_names = list(model.feature_names_in_)            else:                raise ValueError("Model doesn't have feature_names_in_ attribute!")            class_remap = None            if hasattr(model, 'classes_'):                model_classes = sorted(list(model.classes_))                if model_classes == [1, 2]:                    class_remap = {1: 0, 2: 1}                elif model_classes == [0, 1]:                    class_remap = {0: 0, 1: 1}                else:                    messages.addWarning(f"Unexpected class labels: {model_classes}. Using as-is; propagation may fail.")                    class_remap = None            else:                messages.addWarning("Model doesn't have classes_ attribute.")        except Exception as e:            error_msg = f"Failed to load model: {str(e)}"            messages.addError(error_msg)            raise        gis_field_map = {            'grid_code': grid_fld,            'Vertices_Count': verts_fld,            'Slope': slope_fld,            'SPI': spi_fld,            'TouchCount': touch_count_fld,            'AccumTouch': accum_fld,            'VerLeng_ratio': ver_len_ratio_fld,            'Length_Meters': len_meters_fld,            'FLOW_ACC': flow_acc_fld,            'Shape_Length': len_fld,            'AccumVert': accum_vert_fld,            'Straight_Dist': straight_dist_fld,            'Deflection_Ratio': deflection_ratio_fld        }        fc_fields = [f.name for f in arcpy.ListFields(in_fc)]        missing_fields = []        for model_feat in feature_names:            gis_field = gis_field_map.get(model_feat)            if gis_field is None:                missing_fields.append(model_feat)                messages.addError(f"No field mapping defined for model feature '{model_feat}'.")            elif gis_field not in fc_fields:                missing_fields.append(model_feat)                messages.addError(f"Field '{gis_field}' required by the model is missing from the data.")        if missing_fields:            error_msg = f"Missing {len(missing_fields)} required fields: {', '.join(missing_fields)}"            messages.addError(error_msg)            raise ValueError(error_msg)        cursor_fields = ["OID@"] + [gis_field_map[feat] for feat in feature_names]        valid_features = []        valid_oids = []        invalid_oids = []        row_count = 0        with arcpy.da.SearchCursor(in_fc, cursor_fields) as sc:            for row in sc:                row_count += 1                oid = row[0]                feat_vec = list(row[1:])                if None in feat_vec:                    invalid_oids.append(oid)                else:                    valid_features.append(feat_vec)                    valid_oids.append(oid)        messages.addMessage(f"Total features: {row_count}, valid: {len(valid_features)}, with NULL values: {len(invalid_oids)}")        predictions = {}        if valid_features:            try:                messages.addMessage(f"Predicting {len(valid_features)} features...")                batch_predictions = model.predict(valid_features)                if class_remap:                    batch_predictions = [class_remap.get(p, p) for p in batch_predictions]                predictions = dict(zip(valid_oids, batch_predictions))                pred_0 = sum(1 for v in batch_predictions if v == 0)                pred_1 = sum(1 for v in batch_predictions if v == 1)                messages.addMessage(f"Prediction completed: Realistic={pred_0}, UnRealistic={pred_1}")            except Exception as e:                error_msg = f"Prediction failed: {str(e)}"                messages.addError(error_msg)                raise        else:            error_msg = "No valid features to predict!"            messages.addError(error_msg)            raise ValueError(error_msg)        for oid in invalid_oids:            predictions[oid] = None        write_count = 0        null_count = 0        with arcpy.da.UpdateCursor(in_fc, [oid_field, unreal_fld]) as uc:            for row in uc:                pred_val = predictions.get(row[0])                if pred_val is not None:                    row[1] = int(pred_val)                    write_count += 1                else:                    row[1] = None                    null_count += 1                uc.updateRow(row)        messages.addMessage(f"Written: {write_count} predictions, {null_count} NULL")        messages.addMessage("Propagating UnRealistic label from downstream to upstream...")        attrs_unreal = {}        with arcpy.da.SearchCursor(in_fc, [oid_field, grid_fld, unreal_fld]) as cursor:            for oid, grid, unreal in cursor:                attrs_unreal[oid] = {                    'grid': grid if grid is not None else 0,                    'unreal': int(unreal) if unreal is not None else None                }        initial_unreal = sum(1 for v in attrs_unreal.values() if v['unreal'] == 1)        iteration = 0        max_iterations = 100        while iteration < max_iterations:            iteration += 1            to_update = set()            for src_oid, nbrs in touch_idx.items():                src_attr = attrs_unreal.get(src_oid)                if not src_attr or src_attr['unreal'] != 1:                    continue                for nbr_oid in nbrs:                    nbr_attr = attrs_unreal.get(nbr_oid)                    if nbr_attr and nbr_attr['unreal'] != 1:                        if src_attr['grid'] > nbr_attr['grid']:                            to_update.add(nbr_oid)            if not to_update:                break            with arcpy.da.UpdateCursor(in_fc, [oid_field, unreal_fld]) as uc4:                for row in uc4:                    if row[0] in to_update:                        row[1] = 1                        uc4.updateRow(row)                        attrs_unreal[row[0]]['unreal'] = 1        if iteration >= max_iterations:            messages.addWarning(f"Reached max iterations ({max_iterations}); propagation may be incomplete.")        final_unreal = sum(1 for v in attrs_unreal.values() if v['unreal'] == 1)        messages.addMessage(f"Propagation done in {iteration} iterations. UnRealistic: {initial_unreal} -> {final_unreal}")        messages.addMessage("Removing intermediate calculation fields, keeping only 'UnRealistic'...")        helper_fields = [            verts_fld, slope_fld, spi_fld, touch_count_fld, accum_fld,            accum_vert_fld, ver_len_ratio_fld, len_meters_fld,            straight_dist_fld, deflection_ratio_fld,            elev_start_fld, elev_end_fld, flow_acc_fld        ]        current_fields = [f.name for f in arcpy.ListFields(in_fc)]        fields_to_delete = [f for f in helper_fields if f in current_fields]        if fields_to_delete:            arcpy.DeleteField_management(in_fc, fields_to_delete)            messages.addMessage(f"Deleted {len(fields_to_delete)} helper field(s): {', '.join(fields_to_delete)}")        arcpy.CopyFeatures_management(in_fc, out_fc)        try:            arcpy.Delete_management(in_fc)            arcpy.Delete_management(start_pts)            arcpy.Delete_management(end_pts)        except Exception:            pass        messages.addMessage("Dedect tool completed successfully.")        return    def postExecute(self, parameters):        returnclass Correct:    def __init__(self):        self.label = "Correct"        self.description = "This tool reconstructs the river network using a dataset in which unrealistic river segments have been identified."    def getParameterInfo(self):        params = []        param0 = arcpy.Parameter(            displayName="Dedected River Network",            name="in_line",            datatype="GPFeatureLayer",            parameterType="Required",            direction="Input"        )        param0.filter.list = ["Polyline"]        params.append(param0)        param1 = arcpy.Parameter(            displayName="Stream Raster",            name="in_raster",            datatype="GPRasterLayer",            parameterType="Required",            direction="Input"        )        params.append(param1)        param2 = arcpy.Parameter(            displayName="Flow Direction",            name="in_flow_direction",            datatype="GPRasterLayer",            parameterType="Required",            direction="Input"        )        params.append(param2)        param3 = arcpy.Parameter(            displayName="Output Stream Raster",            name="out_raster",            datatype="DERasterDataset",            parameterType="Required",            direction="Output"        )        params.append(param3)        param4 = arcpy.Parameter(            displayName="Stream Order Method",            name="order_method",            datatype="GPString",            parameterType="Required",            direction="Input"        )        param4.filter.type = "ValueList"        param4.filter.list = ["STRAHLER", "SHREVE"]        param4.value = "STRAHLER"        params.append(param4)        return params    def isLicensed(self):        return True    def execute(self, parameters, messages):        in_line = parameters[0].valueAsText        in_raster = parameters[1].valueAsText        in_flow_dir = parameters[2].valueAsText        out_raster = parameters[3].valueAsText        order_method = parameters[4].valueAsText        arcpy.CheckOutExtension("Spatial")        temp_points = "in_memory\\raster_points"        temp_join = "in_memory\\points_line_join"        temp_delete = "in_memory\\points_to_delete"        temp_mask = "in_memory\\delete_mask"        old_extent = arcpy.env.extent        old_snap = arcpy.env.snapRaster        old_cellsize = arcpy.env.cellSize        old_mask = arcpy.env.mask        try:            arcpy.AddMessage("Converting raster to points...")            arcpy.RasterToPoint_conversion(in_raster, temp_points, "Value")            arcpy.AddMessage("Performing spatial join between points and line layer...")            arcpy.SpatialJoin_analysis(temp_points, in_line, temp_join,                                       join_operation="JOIN_ONE_TO_MANY",                                       join_type="KEEP_COMMON",                                       match_option="INTERSECT")            arcpy.AddMessage("Identifying points with an UnRealistic value of 1...")            point_vals = {}            with arcpy.da.SearchCursor(temp_join, ["TARGET_FID", "UnRealistic"]) as cursor:                for pt, u in cursor:                    point_vals.setdefault(pt, set()).add(int(u) if u is not None else None)            to_delete = [oid for oid, s in point_vals.items() if s == {1}]            orig = Raster(in_raster)            arcpy.env.extent = orig.extent            arcpy.env.snapRaster = in_raster            arcpy.env.cellSize = in_raster            arcpy.env.mask = None            if to_delete:                arcpy.AddMessage(f"{len(to_delete)} points marked for deletion.")                oid_field = arcpy.Describe(temp_points).OIDFieldName                clause = f"{oid_field} IN ({','.join(map(str, to_delete))})"                arcpy.MakeFeatureLayer_management(temp_points, "pts_lyr")                arcpy.SelectLayerByAttribute_management("pts_lyr", "NEW_SELECTION", clause)                arcpy.CopyFeatures_management("pts_lyr", temp_delete)                arcpy.Delete_management("pts_lyr")                arcpy.AddField_management(temp_delete, "maskVal", "SHORT")                arcpy.CalculateField_management(temp_delete, "maskVal", "1", "PYTHON3")                cellsize = arcpy.Describe(in_raster).meanCellWidth                arcpy.FeatureToRaster_conversion(temp_delete, "maskVal", temp_mask, cellsize)                arcpy.AddMessage("Cleaning raster using inverse mask...")                mask = Raster(temp_mask)                inverted = SetNull(IsNull(mask), orig)                clean_raster = Con(IsNull(inverted), orig)            else:                arcpy.AddMessage("No points found to delete; using original raster.")                clean_raster = orig            arcpy.AddMessage(f"Calculating {order_method} Stream Order...")            stream_order = StreamOrder(clean_raster, Raster(in_flow_dir), order_method)            stream_order.save(out_raster)            arcpy.AddMessage(f"Stream order raster saved as '{out_raster}'.")        except arcpy.ExecuteError:            arcpy.AddError(arcpy.GetMessages(2))            raise        except Exception as e:            arcpy.AddError(str(e))            raise        finally:            arcpy.env.extent = old_extent            arcpy.env.snapRaster = old_snap            arcpy.env.cellSize = old_cellsize            arcpy.env.mask = old_mask            try:                arcpy.Delete_management(temp_points)                arcpy.Delete_management(temp_join)                arcpy.Delete_management(temp_delete)                arcpy.Delete_management(temp_mask)            except Exception:                pass            arcpy.CheckInExtension("Spatial")    def postExecute(self, parameters):        return